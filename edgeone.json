{
  "name": "memos-on-edgeone",
  "buildCommand": "npm run build:web",
  "installCommand": "npm install && cd web && npm install",
  "outputDirectory": "./web/dist",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "includeFiles": [],
    "maxDuration": 60
  },
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.@(eot|otf|ttf|ttc|woff|woff2|font.css)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|ico|bmp|svg)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "**/*.@(js|css|mjs|js.map|css.map)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "*.@(eot|otf|ttf|ttc|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|ico|bmp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    }
  ]
}

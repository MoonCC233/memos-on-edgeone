{
  "name": "memos-on-edgeone",
  "buildCommand": "npm run build:web",
  "installCommand": "npm install && cd web && npm install",
  "outputDirectory": "./web/dist",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/*.png",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    },
    {
      "source": "/*.webp",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "max-age=604800"
        }
      ]
    }
  ]
}

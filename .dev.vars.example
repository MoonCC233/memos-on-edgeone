# EdgeOne Makers Local Development Configuration
# Copy this file to .dev.vars and fill in your values

# Turso (libSQL) Database - Local Development
# Create a local database at https://turso.tech or use SQLite locally
TURSO_DATABASE_URL_LOCAL=libsql://localhost:8080
TURSO_AUTH_TOKEN_LOCAL=

# Turso (libSQL) Database - Production (for remote migrations)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# EdgeOne Blob Storage (default)
BLOB_STORE_NAME=memos

# Optional: S3-Compatible Storage Configuration
# Uncomment and configure to use S3 instead of EdgeOne Blob
# STORAGE_TYPE=s3
# S3_ENDPOINT=https://s3.your-provider.com
# S3_REGION=auto
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_FORCE_PATH_STYLE=true

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here

# Instance Configuration
INSTANCE_NAME=memos-on-edgeone
APP_VERSION=1.0.0

# Optional: Cloudflare Workers AI (for transcription)
# AI binding not available on EdgeOne, use external API instead
# AI_API_URL=https://api.openai.com/v1
# AI_API_KEY=your-openai-key